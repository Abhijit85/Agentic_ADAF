# Local model paths
PRIMARY_MODEL_PATH=/mnt/shared/shared_hf_home/hub/models--meta-llama--Llama-3.3-70B-Instruct
DEALOG_SUMMARIZER_MODEL_PATH=/mnt/shared/shared_hf_home/hub/models--meta-llama--Llama-3.3-70B-Instruct
VISUAL_CAPTION_MODEL_PATH=/mnt/shared/shared_hf_home/hub/models--Qwen--Qwen2.5-VL-72B-Instruct

# Runtime temp/cache locations
TMPDIR=/mnt/achakr40
PADDLE_PDX_CACHE_HOME=/mnt/data1/achakr40/Agentic_ADAF/models/paddleocr_cache
PADDLEOCR_HOME=/mnt/data1/achakr40/Agentic_ADAF/models/paddleocr_cache

# Required for selecting GPU devises
# OPENROUTER_API_KEY=<set-me>
DEALOG_CUDA_VISIBLE_DEVICES=4,6,7
# Model IDs used by --llm / --summarizer-llm
PRIMARY_MODEL_NAME=meta-llama/Llama-3.3-70B-Instruct
DEALOG_SUMMARIZER_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Force local HF loading
DEALOG_LLM_BACKEND=local

# Writable temp/cache dirs (fixes PermissionError on /mnt/achakr40)
TMPDIR=/tmp
TORCHINDUCTOR_CACHE_DIR=/tmp/torchinductor

