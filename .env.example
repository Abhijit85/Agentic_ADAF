# Runtime backend: use `openrouter` for hosted inference or `local` for on-disk HF checkpoints.
DEALOG_LLM_BACKEND=local

# Hosted backend configuration.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Agentic_ADAF

# Primary reasoning model and summarizer/verifier model labels.
PRIMARY_MODEL_NAME=meta-llama/Llama-3.3-70B-Instruct
DEALOG_SUMMARIZER_MODEL=meta-llama/Llama-3.3-70B-Instruct
DEALOG_SUMMARIZER_TEMPERATURE=0.2
DEALOG_SUMMARIZER_MAX_TOKENS=256

# Optional direct OpenAI key. Present for compatibility with README docs, but
# current code paths use OpenRouter or local checkpoints.
OPENAI_API_KEY=

# Local-backend configuration. Fill these only if DEALOG_LLM_BACKEND=local.
PRIMARY_MODEL_PATH=/mnt/shared/shared_hf_home/hub/models--meta-llama--Llama-3.3-70B-Instruct
DEALOG_SUMMARIZER_MODEL_PATH=/mnt/shared/shared_hf_home/hub/models--meta-llama--Llama-3.3-70B-Instruct
LOCAL_LLM_MODEL_PATH=/mnt/shared/shared_hf_home/hub/models--meta-llama--Llama-3.3-70B-Instruct
LOCAL_LLM_DEVICE_MAP=auto
HF_API_TOKEN=

# Visual pipeline defaults.
VISUAL_CAPTION_MODEL=Salesforce/blip2-flan-t5-xl
VISUAL_CAPTION_MODEL_PATH=
VISUAL_OCR_ENGINE=PaddleOCR
VISUAL_OCR_MODEL_DIR=

# Runtime paths and logging.
DATA_DIR=./data
MODEL_CACHE=./models
LOG_LEVEL=INFO
AGENTIC_TMPDIR=/tmp/agentic_adaf
TMPDIR=/tmp/agentic_adaf

# Optional GPU pinning for longer runs.
DEALOG_CUDA_VISIBLE_DEVICES=
